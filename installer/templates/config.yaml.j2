# Moka AI configuration — generated by installer
# Manual edits to this file may be overwritten by the installer

moka_dir: "{{ install_path }}"
models_dir: "{{ install_path }}/models"
logs_dir: "{{ install_path }}/logs"
data_dir: "{{ install_path }}/data"

hardware:
  gpu: "{{ gpu_model }}"
  vram_gb: {{ vram_gb }}
  compute_capability: "{{ compute_capability }}"

limits:
  max_resolution: {{ max_resolution }}
  max_steps: {{ max_steps }}
  max_concurrent: {{ max_concurrent }}

models:
  base: "{{ base_model }}"
  image: "{{ image_model }}"
  voice: "{{ voice_model }}"

voice:
  wake_word: "Hey Moka"
  tts_voice: "default"